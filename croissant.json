  "@type": "sc:Dataset",
  "@id": "https://doi.org/10.5281/zenodo.19915566",
  "name": "NuReg-XDoc",
  "alternateName": "NRC RAI Cross-Document Regulatory QA Benchmark",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "description": "NuReg-XDoc is a benchmark for cross-document, cross-doctype question answering over the U.S. nuclear regulatory hierarchy. It pairs a corpus of regulatory PDFs (10 CFR, SRP, DSRS, RG) with a typed inter-document reference graph and 938 review queries derived from NRC Requests for Additional Information (RAI), each annotated with document-prescribed evidence chains and a three-valued reference-type taxonomy (normative_basis, methodology_guidance, lateral_cross_reference).",
  "version": "1.0.0",
  "datePublished": "2026-05-07",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://doi.org/10.5281/zenodo.19915566",
  "citeAs": "Kim, B., Lee, H., & Yu, Y. (2026). NuReg-XDoc: A Cross-Doctype Regulatory QA Benchmark with Document-Grounded Reasoning Paths for KG-Augmented RAG (v1.0.0) [Data set]. Zenodo. https://doi.org/10.5281/zenodo.19915566",
